# Copy to a private file (e.g. ~/.atomx-transfer.env, chmod 600) and `source` it before running.
# Never commit the real values.

# AtoMx export SFTP login (your AtoMx account email).
export ATOMX_SFTP_USER="you@example.edu"
# export ATOMX_SFTP_HOST="na.export.atomx.nanostring.com"   # default
# export ATOMX_SFTP_PORT=22                                  # default

# File holding only the SFTP password (chmod 600). run_batch.sh reads it into SFTP_PASSWORD.
export ATOMX_PASSWORD_FILE="$HOME/.tma_sftp_password"

# Where each part of a sample goes in GCS. <sample> folders are created underneath.
export GCS_RAW_DEST_BASE="gs://your-bucket/raw_outputs/raw"
export GCS_ADDITIONAL_DEST_BASE="gs://your-bucket/raw_outputs/additional_files"

# Optional: Slack incoming-webhook URL in a private file, for run_batch.sh status posts.
# export SLACK_WEBHOOK_FILE="$HOME/.slack_tma_webhook"
